{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "build",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-I",
                "${workspaceFolder}/include",
                "-I",
                "${workspaceFolder}/templates",
                "${workspaceFolder}/*.cpp",
                "-o",
                "${workspaceFolder}/bin/${workspaceFolderBasename}",
                "-lSDL2"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "clean",
            "type": "shell",
            "linux": {
                "command": "rm",
                "args": [
                    "-rfv",
                    "bin/*"
                ]
            },
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}