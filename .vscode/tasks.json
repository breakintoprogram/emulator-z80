{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "debug (desktop)",
            "command": "/usr/bin/g++",
            "args": [
				"-std=c++23",
                "-fdiagnostics-color=always",
                "-g",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/*.cpp",
                "-lSDL2",
                "-o${workspaceFolder}/bin/${workspaceFolderBasename}"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "cppbuild",
            "label": "release (desktop)",
            "command": "/usr/bin/g++",
            "args": [
				"-std=c++23",
				"-O3",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/*.cpp",
                "-lSDL2",
                "-o${workspaceFolder}/bin/${workspaceFolderBasename}"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },		
        {
            "type": "cppbuild",
            "label": "release (web)",
            "command": "emcc",
            "args": [
				"-std=c++23",
				"-O3",
				"--use-port=sdl2",
				"--preload-file", "${workspaceFolder}/roms@/roms",
				"--preload-file", "${workspaceFolder}/games@/games",
				"-sNO_DISABLE_EXCEPTION_CATCHING",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/*.cpp",
                "-o${workspaceFolder}/docs/${workspaceFolderBasename}.js"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },				
        {
            "label": "clean",
            "type": "shell",
            "linux": {
                "command": "rm",
                "args": [
                    "-rfv",
                    "bin/*",
					"docs/emulator-z80.*",
                ]
            },
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}