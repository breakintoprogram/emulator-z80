{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "debug",
            "command": "/usr/bin/g++",
            "args": [
				"-std=c++23",
                "-fdiagnostics-color=always",
                "-g",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/*.cpp",
                "-lSDL2",
                "-o${workspaceFolder}/bin/${workspaceFolderBasename}"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "cppbuild",
            "label": "release",
            "command": "/usr/bin/g++",
            "args": [
				"-std=c++23",
				"-O3",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/*.cpp",
                "-lSDL2",
                "-o${workspaceFolder}/bin/${workspaceFolderBasename}"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },		
        {
            "label": "clean",
            "type": "shell",
            "linux": {
                "command": "rm",
                "args": [
                    "-rfv",
                    "bin/*"
                ]
            },
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}